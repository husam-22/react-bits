# ─────────────────────────────────────────────────────────────────────────────
# موقع صَرْح — متغيرات البيئة
# انسخ هذا الملف إلى ‎.env.local‎ للتشغيل المحلي، أو أدخل القيم في إعدادات الاستضافة.
# لا تضع أي قيمة سرية في هذا الملف. كل القيم هنا فارغة عمداً.
# ─────────────────────────────────────────────────────────────────────────────

# ── إعدادات عامة (تظهر في المتصفح) ───────────────────────────────────────────

# عنوان الموقع بعد اعتماد الدومين، بصيغة https://... دون شرطة في النهاية.
# ما دام فارغاً: لا يُكتب canonical ولا روابط Open Graph مطلقة، وتبقى sitemap فارغة.
NEXT_PUBLIC_SITE_URL=

# preview (الافتراضي): إشعارات المعاينة ظاهرة ومحركات البحث ممنوعة من الفهرسة.
# production: للنشر العام بعد استكمال docs/MISSING-DATA.md.
NEXT_PUBLIC_SITE_MODE=preview

# بيانات التواصل الرسمية. أي قيمة فارغة لا تُعرض في الموقع (لا تُستبدل ببيانات وهمية).
# الهاتف بالصيغة الدولية كما يُعرض للزائر، مثال الشكل فقط: +000 000 000 000
NEXT_PUBLIC_CONTACT_PHONE=
# رقم واتساب: أرقام فقط تبدأ بمفتاح الدولة، دون + ودون مسافات.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_CONTACT_HOURS=

# ── ربط نموذج التواصل (على الخادم فقط، لا تصل إلى المتصفح) ──────────────────
# اختر طريقة واحدة. من دون أي منهما يبقى النموذج «غير موصول»: لا يرسل ولا يحفظ شيئاً ويُعلم الزائر بذلك.

# الطريقة 1: Webhook — يُرسل الطلب بصيغة JSON إلى هذا العنوان (نظام CRM، أداة أتمتة، سكربت جداول...).
CONTACT_WEBHOOK_URL=
# اختياري: يُرسل في ترويسة Authorization: Bearer ليتحقق المستقبِل من المصدر.
CONTACT_WEBHOOK_SECRET=

# الطريقة 2: بريد إلكتروني عبر خدمة Resend (https://resend.com).
RESEND_API_KEY=
# بريد المؤسسة الذي يستقبل الطلبات.
CONTACT_TO_EMAIL=
# عنوان المرسل على دومين موثّق في Resend، مثال الشكل فقط: Website <no-reply@your-domain>
CONTACT_FROM_EMAIL=
